ZAPRAM          = 1                     ; to zap or not to zap, that is the question?

; Page Zero defs
;--------------------------------------

; Alloc/Free defs, also used by compiler
zpAllocBase             = $80
zpAllocLast             = $82
zpAllocCurrent          = $84
zpAllocSize             = $86
zpAllocBest             = $88
zpAllocProps            = $88
zpAllocBSize            = $8A
zpAllocOP               = $8A
zpAllocPrevToken        = $8B           ; prev. token value

; current window data / comp. vars
;--------------------------------------

sp              = $8C
choff           = $8D
lnum            = $8E
curproc         = $8E                   ; 2 bytes
dirty           = $8F
top             = $90                   ; -> top line
bot             = $92                   ; -> bottom line
whaddr          = $92                   ; -> current DO frame
cur             = $94                   ; -> current line
x__             = $96                   ; don't use in comp.
y__             = $97                   ; don't use in comp.
nlines          = $98
ioChnnl         = $98                   ; current input file
ytop            = $99
defflg          = $99
indent          = $9A
stackptr        = $9A                   ; op stack offset

buf             = $9B                   ; -> edit buf
insert          = $9D                   ; insert/replace flag
delnxt          = $9E                   ; ->, USED BY LEX

; arguments and temps
;--------------------------------------

args            = $A0
arg0            = $A0
arg1            = $A1
arg2            = $A2
arg3            = $A3
arg4            = $A4
arg5            = $A5
arg6            = $A6
arg7            = $A7
arg8            = $A8
arg9            = $A9
arg10           = $AA
arg11           = $AB
arg12           = $AC
arg13           = $AD
arg14           = $AE
arg15           = $AF

; compiler vars
;--------------------------------------

stbase          = $B0                   ; s.t. base (page)
symTblGlobal    = $B1                   ; qglobal hash table
symTblLocal     = $B3                   ; local hash table
codeoff         = $B5                   ; relocation offset
device          = $B7                   ; default device
qglobal         = $B8                   ; qglobal/local flag
stack           = $B9                   ; value stack
frame           = $BB                   ; -> current frame
symtab          = $BD                   ; -> next s.t. entry
stmax           = $BF                   ; s.t. top (page)
addr            = $C0                   ; token address
token           = $C2                   ; token value

; following defs can be used during
; program execution (user program)
;--------------------------------------

isDirty         = $C3
spln            = $C4                   ; error char
curln           = $C5                   ; error line
curnxt          = $C7                   ; next error line
nxtaddr         = $C9                   ; next token address

;  note: $CA-$CD never referenced

bigSymTblGlobal = $CE                   ; only used if big s.t.
arrayptr        = $D0                   ; array mem. list
spnxt           = $D2                   ; next error char
nxttoken        = $D3                   ; next token value


; ACTION! vars ($480 - $57F)
;--------------------------------------

win1Base        = $0480                 ; window 1 data
cacheTop_HI     = $048F
chrConvert      = $0490                 ; char convert (translate screen code to ascii)
codeBase        = $0491                 ; [word]
codeSize        = $0493                 ; [word]
nSymTblPages    = $0495                 ; symbol table size (pages)
isMonitorLive   = $0496                 ; edit/mon flag
gbase           = $0497                 ; [word]
type            = $0499
isListing       = $049A                 ; listing flag
numargs         = $049B
cmdln           = $049C                 ; command line offset
param           = $049D
opmode          = $049E
currentWindow   = $049F                 ; window memory offset
cury            = $04A0                 ; current Y reg (0/1/unknown)
lastCH          = $04A1                 ; last char
curCH           = $04A2                 ; current char
spareMem        = $04A3                 ; -> spare memory
is2Windows      = $04A5                 ; number of windows (0=single; non-zero=double)
allocerr        = $04A6                 ; INC on Alloc error
delbuf          = $04A7                 ; 6 bytes
firstChar       = $04AD                 ; used for big symbol table
taglist         = $04AE                 ; [word]
chrConvert1     = $04B0                 ; char convert
win2Base        = $04B1                 ; window 2 data
bckgrnd         = $04C0                 ; background color
procSP          = $04C1                 ; Break stack pointer
argbytes        = $04C2
isTrace         = $04C3                 ; trace flag
isBigSymTbl     = $04C4                 ; big symbol table flag

;   note: $4C5 available

jt_jmps         = $04C6                 ; see EDIT.CAR


; Jump table goes to $04FF
;--------------------------------------

jt_vecSegEnd    = $04C6
jt_curbank      = $04C9
jt_stmask       = $04CA
jt_vecError     = $04CB
jt_wsize        = $04CE
jt_linemax      = $04CF
jt_chrConvert2  = $04D0                 ; char convert
jt_vecExpEnd    = $04D1
jt_vecDeclEnd   = jt_vecExpEnd+3
jt_vecCGenEnd   = jt_vecDeclEnd+3
jt_vecArrEnd    = jt_vecCGenEnd+3
jt_vecSPLEnd    = jt_vecArrEnd+3
jt_vecAlarm     = jt_vecSPLEnd+3
jt_eolch        = jt_vecAlarm+3
jt_lsh          = jt_eolch+1

jt_chrConvert3  = $04F0                 ; char convert
jt_tvdisp       = $04F1
jt_vecDispTb    = $04F2
jt_vecStmtEnd   = $04F8
jt_vecStmRAdr   = $04FE


subbuf          = $0500                 ; 40 bytes     ; rowSize
findbuf         = $0528                 ; 40 bytes     ; rowSize
numbuf          = $0550                 ; 24 bytes
stkbase         = $0577

opstack         = $0580                 ; floating-point buffer

; $580 TO ? is used for output of
; FASC routine.  Should not exceed
; 16 bytes, $58F (worst case?).
;--------------------------------------

tempbuf         = $0590                 ; 40 bytes     ; rowSize
argtypes        = $05B8                 ;  8 bytes
eof             = $05C0                 ;  8 bytes
inbuf           = $05C8                 ; 36 bytes
abt             = $05EC                 ;  4 bytes
temps           = $05F0                 ; 16 bytes


; system vars
;--------------------------------------

WARMST          = $08
DOSVEC          = $0A
dosini          = $0C
QCODE           = $0E                   ; ap. high mem.
BRKKEY          = $11
rtclok          = $12
ADRESS          = $64
LMARGN          = $52
RMARGN          = $53
ROWCRS          = $54
COLCRS          = $55
DINDEX          = $57
SAVMSC          = $58
OLDROW          = $5A
OLDCOL          = $5B
OLDADR          = $5E
OLDCHR          = $5D
CSRCH           = $5D
ramtop          = $6A
FR0             = $D4
FR1             = $E0
CIX             = $F2
INBUFF          = $F3
flptr           = $FC

LBUFF           = $0580                 ; line buffer


; window record offsets
;--------------------------------------

WSP             = 0
WCH             = 1
WLNUM           = 2
WDIRTY          = 3
WTOP            = 4
WBOT            = 6
WCUR            = 8
WX              = 10
WY              = 11
WNLINES         = 12                    ; num lines
WYTOP           = 13
WINDENT         = 14


; system defs
;--------------------------------------

EOL             = $9B
ESC             = $1B


; bank switching defs
;---------------------
ml              = $B000
el              = $A000
ll              = $A000
cl              = $A000
bank            = $D500
ebank           = 3
lbank           = 0
cbank           = 9
